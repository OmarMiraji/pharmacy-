{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": [
  {
    "site": "phyimacy-management-system",
    "public": "hosting-redirect",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/", "destination": "https://pharmspecio.web.app/", "type": 301 },
      { "regex": "^/(.*)$", "destination": "https://pharmspecio.web.app/:1", "type": 301 }
    ]
  },
  {
    "site": "pharmspecio",
    "public": "build/site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [{ "regex": "^/app$", "destination": "/app/", "type": 301 }],
    "rewrites": [
      { "source": "/app/**", "destination": "/app/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(css|jpg|jpeg|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/*.@(js|wasm|mjs|json|otf|ttf|png|jpg|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|main.dart.js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
  ],
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "phyimacy-management-system",
          "configurations": {
            "android": "1:433141635482:android:32ac2bb86439bb18c5c223",
            "windows": "1:433141635482:web:d24507df5629fc30c5c223"
          }
        }
      }
    }
  }
}
