{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|wasm|mjs|json|otf|ttf|png|jpg|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|main.dart.js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "phyimacy-management-system",
          "configurations": {
            "android": "1:433141635482:android:32ac2bb86439bb18c5c223",
            "windows": "1:433141635482:web:d24507df5629fc30c5c223"
          }
        }
      }
    }
  }
}
