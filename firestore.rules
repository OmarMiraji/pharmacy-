rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function firestoreRole() {
      return userRecord() != null && 'role' in userRecord().data
        ? userRecord().data.role
        : '';
    }

    function isSuperAdmin() {
      return signedIn()
        && userRecord() != null
        && userRecord().data.isActive != false
        && (
          firestoreRole() == 'super_admin'
          || request.auth.token.role == 'super_admin'
        );
    }

    function tenantId() {
      return userRecord() != null
        && 'pharmacyId' in userRecord().data
        && userRecord().data.pharmacyId is string
        && userRecord().data.pharmacyId.size() > 0
        ? userRecord().data.pharmacyId
        : null;
    }

    function belongsToTenant(id) {
      return isSuperAdmin() || (tenantId() != null && tenantId() == id) || ownsPharmacy(id);
    }

    function ownsPharmacy(id) {
      return signedIn()
        && id is string
        && exists(/databases/$(database)/documents/pharmacies/$(id))
        && (
          get(/databases/$(database)/documents/pharmacies/$(id)).data.ownerUserId == request.auth.uid
          || get(/databases/$(database)/documents/pharmacies/$(id)).data.ownerEmail == request.auth.token.email
        );
    }

    function activeUserRecord() {
      return signedIn() && userRecord() != null && userRecord().data.isActive != false;
    }

    function permissionMap() {
      return userRecord() != null
        && 'permissions' in userRecord().data
        && userRecord().data.permissions is map
        ? userRecord().data.permissions
        : {};
    }

    function storedPermissionValue(permission) {
      return permission in permissionMap()
        ? permissionMap()[permission]
        : (
          permission.split('.').size() == 2
          && permission.split('.')[0] in permissionMap()
          && permissionMap()[permission.split('.')[0]] is map
          && permission.split('.')[1] in permissionMap()[permission.split('.')[0]]
          ? permissionMap()[permission.split('.')[0]][permission.split('.')[1]]
          : null
        );
    }

    function roleDefaultPermission(permission) {
      return (firestoreRole() == 'pharmacist' && permission in [
          'dashboard.view', 'medicines.view', 'medicines.create', 'medicines.update',
          'inventory.view', 'inventory.adjust', 'sales.view', 'sales.create', 'sales.discount',
          'purchases.view', 'purchases.receive', 'suppliers.manage', 'customers.manage', 'reports.view'
        ])
        || (firestoreRole() == 'storekeeper' && permission in [
          'dashboard.view', 'medicines.view', 'medicines.create', 'medicines.update',
          'inventory.view', 'inventory.adjust', 'purchases.view', 'purchases.create',
          'purchases.receive', 'suppliers.manage', 'reports.view'
        ])
        || (firestoreRole() == 'cashier' && permission in [
          'dashboard.view', 'medicines.view', 'inventory.view', 'sales.view', 'sales.create', 'customers.manage'
        ]);
    }

    function hasPermission(permission) {
      return signedIn()
        && activeUserRecord()
        && (
          isSuperAdmin()
          || firestoreRole() == 'admin'
          || (tenantId() != null && ownsPharmacy(tenantId()))
          || storedPermissionValue(permission) == true
          || (storedPermissionValue(permission) != false && roleDefaultPermission(permission))
        );
    }

    function pharmacyDoc(id) {
      return id != null
        && exists(/databases/$(database)/documents/pharmacies/$(id))
        ? get(/databases/$(database)/documents/pharmacies/$(id))
        : null;
    }

    function licenseStartedFor(id) {
      return pharmacyDoc(id) != null && (
        !('startsAt' in pharmacyDoc(id).data)
        || pharmacyDoc(id).data.startsAt == null
        || request.time >= pharmacyDoc(id).data.startsAt
      );
    }

    function licenseExpiredFor(id) {
      return pharmacyDoc(id) != null && (
        (
          'expiresAt' in pharmacyDoc(id).data
          && pharmacyDoc(id).data.expiresAt != null
          && request.time > pharmacyDoc(id).data.expiresAt
        )
        || (
          (!('expiresAt' in pharmacyDoc(id).data) || pharmacyDoc(id).data.expiresAt == null)
          && 'trialEndsAt' in pharmacyDoc(id).data
          && pharmacyDoc(id).data.trialEndsAt != null
          && request.time > pharmacyDoc(id).data.trialEndsAt
        )
      );
    }

    function pharmacyWritableFor(id) {
      return isSuperAdmin() || (
        pharmacyDoc(id) != null
        && pharmacyDoc(id).data.isUnlocked != false
        && (
          !('status' in pharmacyDoc(id).data)
          || pharmacyDoc(id).data.status in ['active', 'trial', 'paid', 'unlocked', 'licensed']
          || pharmacyDoc(id).data.isTrial == true
        )
        && licenseStartedFor(id)
        && !licenseExpiredFor(id)
      );
    }

    function pharmacyWritable() {
      return pharmacyWritableFor(tenantId());
    }

    function inShop(id) {
      return signedIn()
        && id is string
        && id.size() > 0
        && (
          isSuperAdmin()
          || (tenantId() != null && tenantId() == id)
          || ownsPharmacy(id)
        );
    }

    function roleOf(data) {
      return 'role' in data && data.role is string ? data.role : '';
    }

    function isShopStaffRole(role) {
      return role in ['pharmacist', 'cashier', 'storekeeper'];
    }

    function isShopAdminActor() {
      return signedIn()
        && activeUserRecord()
        && (
          firestoreRole() == 'admin'
          || hasPermission('users.manage')
          || (tenantId() != null && ownsPharmacy(tenantId()))
        );
    }

    function staffDocShopId(data) {
      return 'pharmacyId' in data && data.pharmacyId is string && data.pharmacyId.size() > 0
        ? data.pharmacyId
        : null;
    }

    function shopAdminUpdatesStaff(targetUserId) {
      return request.auth.uid != targetUserId
        && isShopAdminActor()
        && staffDocShopId(request.resource.data) != null
        && inShop(staffDocShopId(request.resource.data))
        && (
          staffDocShopId(resource.data) == null
          || staffDocShopId(resource.data) == staffDocShopId(request.resource.data)
        )
        && isShopStaffRole(roleOf(resource.data) == '' ? request.resource.data.role : roleOf(resource.data))
        && isShopStaffRole(request.resource.data.role);
    }

    function selfProfileUpdate(userId) {
      return request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.email == resource.data.email
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'updatedAt']);
    }

    function canReadTenant(id, permission) {
      return inShop(id) && hasPermission(permission);
    }

    function canWriteTenant(id, permission) {
      return inShop(id)
        && activeUserRecord()
        && (isSuperAdmin() || pharmacyWritableFor(id))
        && (
          isSuperAdmin()
          || firestoreRole() == 'admin'
          || ownsPharmacy(id)
          || hasPermission(permission)
        );
    }

    function nonNegNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function medicineValuesValid(data) {
      return (!('sellingPriceMinor' in data) || nonNegNumber(data.sellingPriceMinor))
        && (!('purchasePriceMinor' in data) || nonNegNumber(data.purchasePriceMinor))
        && (!('quantityOnHand' in data) || (data.quantityOnHand is int && data.quantityOnHand >= 0))
        && (!('reorderLevel' in data) || (data.reorderLevel is int && data.reorderLevel >= 0));
    }

    function stockOnlyMedicineKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantityOnHand', 'updatedAt'])
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantityOnHand', 'updatedAt', 'isActive']);
    }

    function purchaseReceiveMedicineKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['quantityOnHand', 'purchasePriceMinor', 'supplierId', 'updatedAt']);
    }

    function saleTotalsValid(data) {
      return data.subtotalMinor is int
        && data.subtotalMinor >= 0
        && data.discountMinor is int
        && data.discountMinor >= 0
        && data.discountMinor <= data.subtotalMinor
        && data.taxMinor is int
        && data.taxMinor >= 0
        && data.totalMinor is int
        && data.totalMinor == data.subtotalMinor - data.discountMinor;
    }

    function saleDiscountAllowed(data) {
      return data.discountMinor == 0
        || isSuperAdmin()
        || firestoreRole() == 'admin'
        || (
          hasPermission('sales.discount')
          && data.discountMinor * 100 <= data.subtotalMinor * 20
        );
    }

    match /pharmacies/{pharmacyId} {
      allow get: if signedIn() && (
        isSuperAdmin()
        || belongsToTenant(pharmacyId)
        || inShop(pharmacyId)
        || resource.data.ownerUserId == request.auth.uid
        || resource.data.ownerEmail == request.auth.token.email
      );
      allow list: if isSuperAdmin() || (
        signedIn() && (
          resource.data.ownerUserId == request.auth.uid
          || resource.data.ownerEmail == request.auth.token.email
          || (tenantId() != null && pharmacyId == tenantId())
        )
      );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        belongsToTenant(pharmacyId)
        && hasPermission('settings.manage')
        && pharmacyWritable()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'address', 'note', 'updatedAt'])
      ) || (
        belongsToTenant(pharmacyId)
        && request.resource.data.activationCode is string
        && exists(/databases/$(database)/documents/subscription_codes/$(request.resource.data.activationCode))
        && (
          get(/databases/$(database)/documents/subscription_codes/$(request.resource.data.activationCode)).data.isUsed == false
          || get(/databases/$(database)/documents/subscription_codes/$(request.resource.data.activationCode)).data.usedByPharmacyId == pharmacyId
        )
        && request.resource.data.status == 'active'
        && request.resource.data.isUnlocked == true
      );
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (tenantId() != null && staffDocShopId(resource.data) == tenantId() && isShopAdminActor())
      );
      allow list: if isSuperAdmin() || (
        isShopAdminActor()
        && staffDocShopId(resource.data) == tenantId()
      );
      allow create: if isSuperAdmin() || (
        request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'admin'
        && request.resource.data.pharmacyId is string
        && exists(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId))
        && (
          get(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)).data.ownerUserId == request.auth.uid
          || get(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)).data.ownerEmail == request.auth.token.email
        )
      ) || (
        signedIn()
        && firestoreRole() == 'admin'
        && tenantId() != null
        && request.resource.data.pharmacyId == tenantId()
        && request.resource.data.role in ['pharmacist', 'cashier', 'storekeeper']
      );
      allow update: if isSuperAdmin() || selfProfileUpdate(userId) || shopAdminUpdatesStaff(userId);
      allow delete: if isSuperAdmin() || (
        hasPermission('users.manage')
        && pharmacyWritable()
        && resource.data.pharmacyId == tenantId()
        && resource.data.role != 'super_admin'
        && resource.data.role != 'admin'
      );
    }

    match /medicines/{medicineId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'medicines.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'medicines.create')
        && medicineValuesValid(request.resource.data);
      allow update: if request.resource.data.pharmacyId == resource.data.pharmacyId
        && medicineValuesValid(request.resource.data)
        && (
          canWriteTenant(resource.data.pharmacyId, 'medicines.update')
          || (
            canWriteTenant(resource.data.pharmacyId, 'inventory.adjust')
            && stockOnlyMedicineKeys()
          )
          || (
            canWriteTenant(resource.data.pharmacyId, 'sales.create')
            && stockOnlyMedicineKeys()
          )
          || (
            (
              canWriteTenant(resource.data.pharmacyId, 'purchases.create')
              || canWriteTenant(resource.data.pharmacyId, 'purchases.receive')
            )
            && purchaseReceiveMedicineKeys()
          )
        );
      allow delete: if canWriteTenant(resource.data.pharmacyId, 'medicines.delete');
    }

    match /medicine_batches/{batchId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'inventory.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'inventory.adjust')
        && request.resource.data.quantityOnHand is int
        && request.resource.data.quantityOnHand >= 0;
      allow update: if request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.quantityOnHand is int
        && request.resource.data.quantityOnHand >= 0
        && (
          (
            canWriteTenant(resource.data.pharmacyId, 'inventory.adjust')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantityOnHand', 'isActive', 'updatedAt', 'writtenOffReason', 'writtenOffAt'
            ])
          )
          || (
            canWriteTenant(resource.data.pharmacyId, 'medicines.update')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiryDate', 'updatedAt'])
          )
          || (
            canWriteTenant(resource.data.pharmacyId, 'sales.create')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantityOnHand', 'isActive', 'updatedAt'
            ])
          )
        );
      allow delete: if canWriteTenant(resource.data.pharmacyId, 'medicines.delete');
    }

    match /categories/{categoryId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'medicines.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'medicines.update');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'medicines.update');
    }

    match /suppliers/{supplierId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'suppliers.manage');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'suppliers.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'suppliers.manage');
    }

    match /customers/{customerId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'customers.manage');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'customers.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'customers.manage');
    }

    match /purchases/{purchaseId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'purchases.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'purchases.create');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'purchases.create');

      match /items/{itemId} {
        allow read: if isSuperAdmin() || canReadTenant(get(/databases/$(database)/documents/purchases/$(purchaseId)).data.pharmacyId, 'purchases.view');
        allow write: if canWriteTenant(get(/databases/$(database)/documents/purchases/$(purchaseId)).data.pharmacyId, 'purchases.create');
      }
    }

    match /sales/{saleId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'sales.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'sales.create')
        && saleTotalsValid(request.resource.data)
        && saleDiscountAllowed(request.resource.data);
      allow update: if canWriteTenant(resource.data.pharmacyId, 'sales.refund')
        && saleTotalsValid(request.resource.data)
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.subtotalMinor == resource.data.subtotalMinor
        && request.resource.data.discountMinor == resource.data.discountMinor
        && request.resource.data.totalMinor == resource.data.totalMinor;
      allow delete: if isSuperAdmin();

      match /items/{itemId} {
        allow read: if isSuperAdmin() || canReadTenant(get(/databases/$(database)/documents/sales/$(saleId)).data.pharmacyId, 'sales.view');
        allow create: if canWriteTenant(get(/databases/$(database)/documents/sales/$(saleId)).data.pharmacyId, 'sales.create')
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.unitPriceMinor is int
          && request.resource.data.unitPriceMinor >= 0
          && request.resource.data.totalMinor is int
          && request.resource.data.totalMinor >= 0;
        allow update, delete: if false;
      }
    }

    match /stock_movements/{movementId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'inventory.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'inventory.adjust')
        || canWriteTenant(request.resource.data.pharmacyId, 'sales.create')
        || canWriteTenant(request.resource.data.pharmacyId, 'purchases.create');
      allow update, delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'expenses.manage');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'expenses.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'expenses.manage');
    }

    match /settings/{settingId} {
      allow read: if isSuperAdmin() || canReadTenant(resource.data.pharmacyId, 'settings.manage');
      allow write: if canWriteTenant(request.resource.data.pharmacyId, 'settings.manage');
    }

    match /subscription_codes/{codeId} {
      allow get: if isSuperAdmin() || (signedIn() && resource.data.isUsed == false && resource.data.code == codeId);
      allow list: if isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        signedIn()
        && resource.data.isUsed == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isUsed', 'usedByPharmacyId', 'usedByUserId', 'usedAt', 'updatedAt'])
        && request.resource.data.isUsed == true
        && request.resource.data.usedByUserId == request.auth.uid
        && request.resource.data.usedByPharmacyId == tenantId()
      );
    }

    match /subscriptions/{userId} {
      allow read, write: if isSuperAdmin();
    }

    match /app_releases/{releaseId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }
  }
}
