rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules stop after 1000 evaluated expressions per request, so the caller and shop
    // documents are read once per entry function and passed down as maps.
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function shopData(id) {
      return id is string && id.size() > 0 && exists(/databases/$(database)/documents/pharmacies/$(id))
        ? get(/databases/$(database)/documents/pharmacies/$(id)).data
        : {};
    }

    function roleIn(u) {
      return u.get('role', '') is string ? u.get('role', '').lower() : '';
    }

    function activeIn(u) {
      return u.size() > 0 && u.get('isActive', true) != false;
    }

    function tenantIn(u) {
      return u.get('pharmacyId', '') is string && u.get('pharmacyId', '').size() > 0
        ? u.get('pharmacyId', '')
        : null;
    }

    function superIn(u) {
      return activeIn(u) && (
        roleIn(u) == 'super_admin'
        || request.auth.token.get('role', '') == 'super_admin'
      );
    }

    function ownsShop(s) {
      return signedIn() && s.size() > 0 && (
        s.get('ownerUserId', '') == request.auth.uid
        || (
          request.auth.token.get('email', '') is string
          && s.get('ownerEmail', '') is string
          && s.get('ownerEmail', '').size() > 0
          && s.get('ownerEmail', '').lower() == request.auth.token.get('email', '').lower()
        )
      );
    }

    function shopStarted(s) {
      return !(s.get('startsAt', null) is timestamp)
        || request.time + duration.value(1, 'd') >= s.get('startsAt', null);
    }

    function shopExpired(s) {
      return s.get('expiresAt', null) is timestamp
        ? request.time >= s.get('expiresAt', null) + duration.value(1, 'd')
        : (
          s.get('trialEndsAt', null) is timestamp
          && request.time >= s.get('trialEndsAt', null) + duration.value(1, 'd')
        );
    }

    function shopWritable(s) {
      return s.size() > 0
        && s.get('isUnlocked', true) != false
        && shopStarted(s)
        && !shopExpired(s);
    }

    function storedPerm(u, permission) {
      return !(u.get('permissions', {}) is map)
        ? null
        : permission in u.get('permissions', {})
          ? u.get('permissions', {})[permission]
          : (
            permission.split('.')[0] in u.get('permissions', {})
            && u.get('permissions', {})[permission.split('.')[0]] is map
          )
            ? u.get('permissions', {})[permission.split('.')[0]].get(permission.split('.')[1], null)
            : null;
    }

    function roleDefault(role, permission) {
      return (role == 'pharmacist' && permission in [
          'dashboard.view', 'medicines.view', 'medicines.create', 'medicines.update',
          'inventory.view', 'inventory.adjust', 'sales.view', 'sales.create', 'sales.discount',
          'purchases.view', 'purchases.receive', 'suppliers.manage', 'customers.manage', 'reports.view'
        ])
        || (role == 'storekeeper' && permission in [
          'dashboard.view', 'medicines.view', 'medicines.create', 'medicines.update',
          'inventory.view', 'inventory.adjust', 'purchases.view', 'purchases.create',
          'purchases.receive', 'suppliers.manage', 'reports.view'
        ])
        || (role == 'cashier' && permission in [
          'dashboard.view', 'medicines.view', 'inventory.view', 'sales.view', 'sales.create', 'customers.manage'
        ]);
    }

    function isManager(u, s) {
      return activeIn(u) && (superIn(u) || roleIn(u) == 'admin' || ownsShop(s));
    }

    function staffPerm(u, permission) {
      let stored = storedPerm(u, permission);
      return activeIn(u) && (
        stored == true
        || (
          (stored != false || permission in ['dashboard.view', 'medicines.view', 'inventory.view'])
          && roleDefault(roleIn(u), permission)
        )
      );
    }

    function hasPerm(u, s, permission) {
      return isManager(u, s) || staffPerm(u, permission);
    }

    function inShopWith(u, s, id) {
      return signedIn()
        && id is string
        && id.size() > 0
        && (superIn(u) || tenantIn(u) == id || ownsShop(s));
    }

    function writeBase(u, s, id) {
      return inShopWith(u, s, id)
        && activeIn(u)
        && (superIn(u) || shopWritable(s));
    }

    function writeAllowed(u, s, id, permission) {
      return writeBase(u, s, id) && hasPerm(u, s, permission);
    }

    function isSuperAdmin() {
      return superIn(me());
    }

    function firestoreRole() {
      return roleIn(me());
    }

    function tenantId() {
      return tenantIn(me());
    }

    function activeUserRecord() {
      return activeIn(me());
    }

    function ownsPharmacy(id) {
      return ownsShop(shopData(id));
    }

    function hasPermission(permission) {
      let u = me();
      return hasPerm(u, shopData(tenantIn(u)), permission);
    }

    function pharmacyWritable() {
      let u = me();
      return superIn(u) || shopWritable(shopData(tenantIn(u)));
    }

    function inShop(id) {
      return inShopWith(me(), shopData(id), id);
    }

    function belongsToTenant(id) {
      return inShop(id);
    }

    function isShopAdminActor() {
      let u = me();
      return hasPerm(u, shopData(tenantIn(u)), 'users.manage');
    }

    function canReadTenant(id, permission) {
      let u = me();
      let s = shopData(id);
      return inShopWith(u, s, id) && hasPerm(u, s, permission);
    }

    function canReadStock(id) {
      let u = me();
      let s = shopData(id);
      return inShopWith(u, s, id) && (
        isManager(u, s)
        || staffPerm(u, 'medicines.view')
        || staffPerm(u, 'dashboard.view')
        || staffPerm(u, 'inventory.view')
        || staffPerm(u, 'sales.create')
      );
    }

    function canWriteTenant(id, permission) {
      let u = me();
      return writeAllowed(u, shopData(id), id, permission);
    }

    function canWriteEither(id, first, second) {
      let u = me();
      let s = shopData(id);
      return writeBase(u, s, id) && (isManager(u, s) || staffPerm(u, first) || staffPerm(u, second));
    }

    function canWriteStockLedger(id) {
      let u = me();
      let s = shopData(id);
      return writeBase(u, s, id) && (
        isManager(u, s)
        || staffPerm(u, 'sales.create')
        || (request.resource.data.type == 'sale_void' && staffPerm(u, 'sales.refund'))
        || staffPerm(u, 'inventory.adjust')
        || staffPerm(u, 'purchases.create')
        || staffPerm(u, 'purchases.receive')
      );
    }

    function roleOf(data) {
      return 'role' in data && data.role is string ? data.role : '';
    }

    function isShopStaffRole(role) {
      return role in ['pharmacist', 'cashier', 'storekeeper'];
    }

    function staffDocShopId(data) {
      return 'pharmacyId' in data && data.pharmacyId is string && data.pharmacyId.size() > 0
        ? data.pharmacyId
        : null;
    }

    function shopAdminUpdatesStaff(targetUserId) {
      return request.auth.uid != targetUserId
        && isShopAdminActor()
        && staffDocShopId(request.resource.data) != null
        && inShop(staffDocShopId(request.resource.data))
        && (
          staffDocShopId(resource.data) == null
          || staffDocShopId(resource.data) == staffDocShopId(request.resource.data)
        )
        && isShopStaffRole(roleOf(resource.data) == '' ? request.resource.data.role : roleOf(resource.data))
        && isShopStaffRole(request.resource.data.role);
    }

    function selfProfileUpdate(userId) {
      return request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.email == resource.data.email
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'updatedAt']);
    }

    function shopIdOf(data) {
      return data != null && 'pharmacyId' in data && data.pharmacyId is string ? data.pharmacyId : '';
    }

    function saleParentReadable(saleId) {
      let id = shopIdOf(
        exists(/databases/$(database)/documents/sales/$(saleId))
          ? get(/databases/$(database)/documents/sales/$(saleId)).data
          : {}
      );
      let u = me();
      let s = shopData(id);
      return inShopWith(u, s, id)
        && (hasPerm(u, s, 'sales.view') || hasPerm(u, s, 'sales.records') || hasPerm(u, s, 'sales.refund'));
    }

    function writeShopId(data) {
      return shopIdOf(data).size() > 0 ? shopIdOf(data) : tenantId();
    }

    function nonNegNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function medicineValuesValid(data) {
      return (!('sellingPriceMinor' in data) || nonNegNumber(data.sellingPriceMinor))
        && (!('purchasePriceMinor' in data) || nonNegNumber(data.purchasePriceMinor))
        && (!('quantityOnHand' in data) || (nonNegNumber(data.quantityOnHand)))
        && (!('reorderLevel' in data) || (data.reorderLevel is int && data.reorderLevel >= 0));
    }

    function stockOnlyMedicineKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantityOnHand', 'updatedAt', 'isActive']);
    }

    function purchaseReceiveMedicineKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['quantityOnHand', 'purchasePriceMinor', 'supplierId', 'updatedAt']);
    }

    function batchStockKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['quantityOnHand', 'isActive', 'updatedAt', 'pharmacyId']);
    }

    function saleTotalsValid(data) {
      return nonNegNumber(data.subtotalMinor)
        && nonNegNumber(data.discountMinor)
        && data.discountMinor <= data.subtotalMinor
        && nonNegNumber(data.taxMinor)
        && nonNegNumber(data.totalMinor)
        && data.totalMinor == data.subtotalMinor - data.discountMinor;
    }

    function purchaseCorrectionValid(data) {
      return nonNegNumber(data.quantityReceived)
        && data.quantityReceived > 0
        && nonNegNumber(data.subtotalMinor)
        && nonNegNumber(data.totalMinor)
        && data.totalMinor == data.subtotalMinor;
    }

    function saleDiscountAllowed(data) {
      let u = me();
      return data.discountMinor == 0
        || superIn(u)
        || roleIn(u) == 'admin'
        || (
          hasPerm(u, shopData(tenantIn(u)), 'sales.discount')
          && data.discountMinor * 100 <= data.subtotalMinor * 20
        );
    }

    function medicineUpdateAllowed(id) {
      let u = me();
      let s = shopData(id);
      return writeBase(u, s, id) && (
        isManager(u, s)
        || (stockOnlyMedicineKeys() && (staffPerm(u, 'sales.create') || staffPerm(u, 'inventory.adjust') || staffPerm(u, 'sales.refund')))
        || (purchaseReceiveMedicineKeys() && staffPerm(u, 'purchases.receive'))
        || staffPerm(u, 'medicines.update')
      );
    }

    function batchUpdateAllowed(id) {
      let u = me();
      let s = shopData(id);
      return writeBase(u, s, id) && (
        isManager(u, s)
        || (batchStockKeys() && (staffPerm(u, 'sales.create') || staffPerm(u, 'purchases.receive') || staffPerm(u, 'sales.refund')))
        || staffPerm(u, 'medicines.update')
        || staffPerm(u, 'inventory.adjust')
      );
    }

    match /pharmacies/{pharmacyId} {
      allow get: if signedIn() && (
        inShop(pharmacyId)
        || resource.data.ownerUserId == request.auth.uid
        || resource.data.ownerEmail == request.auth.token.email
      );
      allow list: if isSuperAdmin() || (
        signedIn() && (
          resource.data.ownerUserId == request.auth.uid
          || resource.data.ownerEmail == request.auth.token.email
          || (tenantId() != null && pharmacyId == tenantId())
        )
      );
      allow create: if isSuperAdmin();
      allow update: if signedIn()
        && request.resource.data.activationCode is string
        && request.resource.data.status == 'active'
        && request.resource.data.isUnlocked == true;
      allow update: if isSuperAdmin();
      allow update: if belongsToTenant(pharmacyId)
        && hasPermission('settings.manage')
        && pharmacyWritable()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'address', 'note', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (tenantId() != null && staffDocShopId(resource.data) == tenantId() && isShopAdminActor())
      );
      allow list: if isSuperAdmin() || (
        isShopAdminActor()
        && staffDocShopId(resource.data) == tenantId()
      );
      allow create: if isSuperAdmin() || (
        request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'admin'
        && request.resource.data.pharmacyId is string
        && ownsPharmacy(request.resource.data.pharmacyId)
      ) || (
        signedIn()
        && firestoreRole() == 'admin'
        && tenantId() != null
        && request.resource.data.pharmacyId == tenantId()
        && request.resource.data.role in ['pharmacist', 'cashier', 'storekeeper']
      );
      allow update: if isSuperAdmin() || selfProfileUpdate(userId) || shopAdminUpdatesStaff(userId) || (
        request.auth.uid == userId
        && request.resource.data.role == 'admin'
        && request.resource.data.pharmacyId is string
        && ownsPharmacy(request.resource.data.pharmacyId)
        && resource.data.role != 'super_admin'
      );
      allow delete: if isSuperAdmin() || (
        hasPermission('users.manage')
        && pharmacyWritable()
        && resource.data.pharmacyId == tenantId()
        && resource.data.role != 'super_admin'
        && resource.data.role != 'admin'
      );
    }

    match /medicines/{medicineId} {
      allow read: if canReadStock(resource.data.pharmacyId);
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'medicines.create')
        && medicineValuesValid(request.resource.data);
      allow update: if medicineValuesValid(request.resource.data)
        && (shopIdOf(resource.data).size() == 0 || request.resource.data.pharmacyId == resource.data.pharmacyId)
        && medicineUpdateAllowed(writeShopId(resource.data));
      allow delete: if canWriteTenant(writeShopId(resource.data), 'medicines.delete');
    }

    match /medicine_batches/{batchId} {
      allow read: if canReadStock(writeShopId(resource.data));
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'medicines.create')
        && nonNegNumber(request.resource.data.quantityOnHand);
      allow update: if nonNegNumber(request.resource.data.quantityOnHand)
        && (shopIdOf(resource.data).size() == 0 || request.resource.data.pharmacyId == resource.data.pharmacyId)
        && batchUpdateAllowed(writeShopId(resource.data));
      allow delete: if canWriteTenant(writeShopId(resource.data), 'medicines.delete');
    }

    match /categories/{categoryId} {
      allow read: if canReadStock(resource.data.pharmacyId);
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'medicines.create');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'medicines.update');
    }

    match /suppliers/{supplierId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'suppliers.manage')
        || canReadTenant(resource.data.pharmacyId, 'purchases.view');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'suppliers.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'suppliers.manage');
    }

    match /customers/{customerId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'customers.manage');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'customers.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'customers.manage');
    }

    match /purchases/{purchaseId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'purchases.view');
      allow create: if canWriteEither(request.resource.data.pharmacyId, 'purchases.create', 'purchases.receive');
      allow update: if request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantityReceived', 'subtotalMinor', 'totalMinor', 'updatedAt'])
        && purchaseCorrectionValid(request.resource.data)
        && canWriteEither(resource.data.pharmacyId, 'purchases.create', 'purchases.receive');
      allow delete: if isSuperAdmin();

      match /items/{itemId} {
        allow read: if canReadTenant(shopIdOf(resource.data), 'purchases.view')
          || (
            exists(/databases/$(database)/documents/purchases/$(purchaseId))
            && canReadTenant(shopIdOf(get(/databases/$(database)/documents/purchases/$(purchaseId)).data), 'purchases.view')
          );
        allow create: if canWriteEither(request.resource.data.pharmacyId, 'purchases.create', 'purchases.receive');
        allow update: if request.resource.data.pharmacyId == resource.data.pharmacyId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity', 'totalMinor', 'updatedAt'])
          && nonNegNumber(request.resource.data.quantity)
          && request.resource.data.quantity > 0
          && nonNegNumber(request.resource.data.totalMinor)
          && exists(/databases/$(database)/documents/purchases/$(purchaseId))
          && canWriteEither(
            shopIdOf(get(/databases/$(database)/documents/purchases/$(purchaseId)).data),
            'purchases.create',
            'purchases.receive'
          );
        allow delete: if isSuperAdmin();
      }
    }

    match /sales/{saleId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'sales.view')
        || canReadTenant(resource.data.pharmacyId, 'sales.records');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'sales.create')
        && saleTotalsValid(request.resource.data)
        && saleDiscountAllowed(request.resource.data);
      allow update: if request.resource.data.pharmacyId == resource.data.pharmacyId
        && saleTotalsValid(request.resource.data)
        && saleDiscountAllowed(request.resource.data)
        && canWriteEither(resource.data.pharmacyId, 'sales.create', 'sales.refund');
      allow delete: if isSuperAdmin();

      match /items/{itemId} {
        allow read: if canReadTenant(shopIdOf(resource.data), 'sales.view')
          || canReadTenant(shopIdOf(resource.data), 'sales.records')
          || saleParentReadable(saleId);
        allow create: if canWriteTenant(request.resource.data.pharmacyId, 'sales.create')
          && nonNegNumber(request.resource.data.quantity)
          && request.resource.data.quantity > 0
          && nonNegNumber(request.resource.data.unitPriceMinor)
          && nonNegNumber(request.resource.data.totalMinor);
        allow update, delete: if false;
      }
    }

    match /stock_movements/{movementId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'inventory.view')
        || canReadTenant(resource.data.pharmacyId, 'sales.view')
        || canReadTenant(resource.data.pharmacyId, 'sales.refund')
        || canReadTenant(resource.data.pharmacyId, 'purchases.view')
        || canReadTenant(resource.data.pharmacyId, 'purchases.receive');
      allow create: if canWriteStockLedger(request.resource.data.pharmacyId);
      allow update: if isSuperAdmin() || (
        resource.data.type == 'purchase'
        && request.resource.data.type == 'purchase'
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantityChange', 'units', 'direction', 'updatedAt'])
        && nonNegNumber(request.resource.data.quantityChange)
        && request.resource.data.quantityChange > 0
        && request.resource.data.units == request.resource.data.quantityChange
        && request.resource.data.direction == 'in'
        && canWriteEither(resource.data.pharmacyId, 'purchases.create', 'purchases.receive')
      );
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'expenses.manage');
      allow create: if canWriteTenant(request.resource.data.pharmacyId, 'expenses.manage');
      allow update, delete: if canWriteTenant(resource.data.pharmacyId, 'expenses.manage');
    }

    match /settings/{settingId} {
      allow read: if canReadTenant(resource.data.pharmacyId, 'settings.manage');
      allow write: if canWriteTenant(request.resource.data.pharmacyId, 'settings.manage');
    }

    match /subscription_codes/{codeId} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        signedIn()
        && resource.data.isUsed != true
        && request.resource.data.isUsed == true
        && request.resource.data.usedByUserId == request.auth.uid
        && request.resource.data.usedByPharmacyId is string
        && request.resource.data.usedByPharmacyId.size() > 0
        && (
          !('pharmacyId' in resource.data)
          || resource.data.pharmacyId == null
          || resource.data.pharmacyId == ''
          || resource.data.pharmacyId == request.resource.data.usedByPharmacyId
        )
      );
    }

    match /subscriptions/{userId} {
      allow read, write: if isSuperAdmin();
    }

    match /app_releases/{releaseId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /login_sessions/{sessionId} {
      allow get, list: if isSuperAdmin() || (
        isShopAdminActor()
        && tenantId() != null
        && resource.data.pharmacyId == tenantId()
      );
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.event in ['login', 'logout']
        && request.resource.data.actorName is string
        && request.resource.data.role is string
        && request.resource.data.pharmacyId is string
        && request.resource.data.pharmacyName is string
        && request.resource.data.createdAt == request.time
        && (
          isSuperAdmin()
          || (tenantId() != null && request.resource.data.pharmacyId == tenantId())
        );
      allow update: if false;
      allow delete: if isSuperAdmin() || (
        tenantId() != null
        && isShopAdminActor()
        && (
          !('pharmacyId' in resource.data)
          || resource.data.pharmacyId == null
          || resource.data.pharmacyId == ''
          || resource.data.pharmacyId == tenantId()
        )
      );
    }

    match /license_payments/{paymentId} {
      allow read, write: if isSuperAdmin();
    }

    match /mail_settings/{docId} {
      allow read: if isSuperAdmin() || firestoreRole() == 'admin';
      allow write: if isSuperAdmin();
    }

    match /auth_index/{id} {
      allow read, write: if isSuperAdmin() || firestoreRole() == 'admin';
    }
  }
}
